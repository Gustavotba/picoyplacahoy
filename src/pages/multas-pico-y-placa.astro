---
import Principal from '../layouts/Principal.astro';
import ValorMulta from '../components/ValorMulta.astro';
import HistorialMulta from '../components/HistorialMulta.astro';
import CalculadoraPlazos from '../components/CalculadoraPlazos.astro';
import CostoInmovilizacion from '../components/CostoInmovilizacion.astro';
import { ciudades } from '../lib/ciudades';
import { fechaColombia } from '../lib/calcular';
import { breadcrumbJsonLd, SITE_URL } from '../lib/seo';
import {
  multaVigente,
  valoresPorTipo,
  cantidadUvbPorTipo,
  cantidadUvbCircular,
  inmovilizacionBogota,
  describirVariacion,
  fraseVariacion,
  formatearPesos,
  formatearUnidades,
} from '../lib/multas';
import type { MultaDelAnio, TipoInfraccion } from '../lib/multas';
import type { Ciudad } from '../lib/tipos';

// Se arma en cada visita: el 1 de enero el valor cambia de año solo (en cuanto
// el año nuevo esté cargado en src/data/multas.json) y, si todavía no lo está,
// la página lo dice. Prerenderizada se quedaría con el año del último build.
export const prerender = false;

// ?fecha=YYYY-MM-DD simula otro día, igual que en las páginas de ciudad.
const fechaParam = Astro.url.searchParams.get('fecha');
const fechaSimulada = fechaParam ? new Date(fechaParam + 'T12:00:00') : null;
const simulacionValida = fechaSimulada !== null && !Number.isNaN(fechaSimulada.getTime());
const fecha = simulacionValida ? fechaSimulada : fechaColombia();

const multa = multaVigente(fecha);
const valor = formatearPesos(multa.multa);
const con5 = formatearPesos(multa.conCurso5Dias);
const con20 = formatearPesos(multa.conCurso20Dias);
const unidades = `${formatearUnidades(multa.cantidad_unidades)} ${multa.unidad}`;
const valorUnidad = formatearPesos(multa.valor_unidad);
const variacion = fraseVariacion(multa);
const valores = valoresPorTipo(multa);

// Compartir por WhatsApp: es solo un enlace (cero JavaScript). La etiqueta
// utm_source permite ver en Analytics cuántas visitas llegan por ahí.
const textoWhatsApp = `Multa por Pico y Placa ${multa.anio}: ${valor}. Con curso en los primeros 5 días hábiles pagas ${con5}. Calcula hasta cuándo tienes descuento: ${SITE_URL}/multas-pico-y-placa?utm_source=whatsapp&utm_medium=compartir#calculadora`;
const enlaceWhatsApp = `https://wa.me/?text=${encodeURIComponent(textoWhatsApp)}`;

// Ejemplo de Bogotá para la pregunta de los patios (solo si es del mismo año)
const ej = inmovilizacionBogota;
const ejemploVigente = ej.anio === multa.anio;

const titulo = `Multa por Pico y Placa ${multa.anio}: ${valor} — descuentos e inmovilización`;
const descripcion = `La multa por Pico y Placa en ${multa.anio} es de ${valor} (infracción C.14, ${unidades}) más la inmovilización del vehículo. Con curso pagas ${con5} en los primeros 5 días o ${con20} hasta el día 20.${variacion ? ` ${variacion}.` : ''}`;

// Escala general del artículo 131 de la Ley 769 de 2002 (texto vigente tras la
// Ley 1383 de 2010). El Pico y Placa es la C.14: tercer escalón de cuatro.
const escala: Array<{ tipo: TipoInfraccion; smldv: number; nota: string; esPyp: boolean }> = [
  { tipo: 'A', smldv: 4, nota: 'Conductores de vehículos no automotores (bicicletas, tracción animal).', esPyp: false },
  { tipo: 'B', smldv: 8, nota: 'Por ejemplo, equipos de sonido a volumen excesivo (B.23).', esPyp: false },
  { tipo: 'C', smldv: 15, nota: 'Pico y Placa (C.14), estacionar en sitio prohibido (C.2), bloquear una calzada (C.3).', esPyp: true },
  { tipo: 'D', smldv: 30, nota: 'Las infracciones más graves de la escala general.', esPyp: false },
];
// La escala en pesos solo tiene sentido con la UVB (desde 2024)
const escalaEnPesos = multa.unidad === 'UVB';

/** "el valor de la UVB pasó de $11.552 a $12.110" */
function explicarCambio(m: MultaDelAnio): string {
  const a = m.anterior;
  if (!a) return '';
  if (a.unidad !== m.unidad) return `ese año la multa dejó de calcularse en ${a.unidad} y pasó a ${m.unidad}`;
  return `el valor de la ${m.unidad} pasó de ${formatearPesos(a.valor_unidad)} a ${formatearPesos(m.valor_unidad)}`;
}

// Pregunta sobre el cambio frente al año anterior, redactada según lo que pasó
const preguntaVariacion = (() => {
  if (multa.variacion === null || !multa.anterior) return null;
  const v = describirVariacion(multa.variacion);
  const ant = multa.anterior;
  if (v.sentido === 'igual') {
    return {
      pregunta: `¿Cambió la multa de Pico y Placa en ${multa.anio}?`,
      respuesta: `No. En ${multa.anio} sigue en ${valor}, igual que en ${ant.anio}. Desde 2024 la multa se ajusta cada enero con la UVB, que sigue la inflación, y ya no con el salario mínimo.`,
    };
  }
  const verbo = v.sentido === 'sube' ? 'subió' : 'bajó';
  return {
    pregunta: `¿Cuánto ${verbo} la multa de Pico y Placa en ${multa.anio}?`,
    respuesta: `${v.sentido === 'sube' ? 'Subió' : 'Bajó'} ${v.porcentaje}: pasó de ${formatearPesos(ant.multa)} en ${ant.anio} a ${valor} en ${multa.anio}, porque ${explicarCambio(multa)}. Desde 2024 la multa se ajusta cada enero con la UVB, que sigue la inflación, y ya no con el salario mínimo.`,
  };
})();

// Las preguntas se escriben UNA sola vez y alimentan el HTML y el JSON-LD FAQPage,
// para que no puedan quedar diciendo cosas distintas (mismo patrón de la portada).
const preguntas = [
  {
    pregunta: `¿Cuánto cuesta la multa por Pico y Placa en ${multa.anio}?`,
    respuesta: `${valor}. Es la infracción C.14 del Código Nacional de Tránsito, una multa tipo C que desde 2024 se liquida en ${unidades} (Unidades de Valor Básico); en ${multa.anio} cada UVB vale ${valorUnidad}. Si aceptas la infracción y haces el curso, pagas ${con5} dentro de los 5 días siguientes al comparendo o ${con20} hasta el día 20. Además, el vehículo se inmoviliza y la grúa y los patios se pagan aparte.`,
  },
  ...(preguntaVariacion ? [preguntaVariacion] : []),
  {
    pregunta: '¿Por qué veo cifras distintas de la multa de Pico y Placa?',
    respuesta: `Por tres razones. Redondeo: el Ministerio de Transporte convirtió la multa en ${formatearUnidades(cantidadUvbCircular)} UVB y Bogotá y los decretos de 2026 usan ${formatearUnidades(multa.cantidad_unidades)}, así que hay fuentes con unos $100 de diferencia. Cifras viejas: el valor cambia cada enero y muchas páginas no se actualizan. Y cálculos con el salario mínimo: esa regla dejó de aplicarse en 2020, cuando las multas pasaron a UVT, y desde 2024 se calculan en UVB. El valor de ${multa.anio} es ${valor}.`,
  },
  {
    pregunta: '¿Me pueden inmovilizar el carro o la moto por Pico y Placa?',
    respuesta:
      'Sí. El propio texto de la infracción C.14 ordena la inmovilización. El vehículo se lleva a los patios autorizados y el propietario paga la grúa y el tiempo de parqueadero, con las tarifas que fija cada autoridad de tránsito local.',
  },
  {
    pregunta: '¿La multa de Pico y Placa tiene descuento por pago pronto?',
    respuesta: `Sí. Si aceptas la infracción y haces el curso sobre normas de tránsito, pagas el 50 % (${con5} en ${multa.anio}) dentro de los 5 días siguientes al comparendo, o el 75 % (${con20}) dentro de los 20 días siguientes (artículo 136 de la Ley 769 de 2002). Pasado ese plazo se paga el 100 %: ${valor}.`,
  },
  {
    pregunta: '¿Hasta cuándo tengo el descuento en la multa de Pico y Placa?',
    respuesta:
      'Si te la puso un agente, tienes 5 días hábiles para pagar el 50 % y hasta el día 20 hábil para pagar el 75 %, siempre con el curso. Si es fotomulta, los plazos corren desde que te llega la notificación: 11 días hábiles para el 50 % y hasta el día 26 para el 75 %. Los días hábiles no cuentan sábados, domingos ni festivos. En esta página hay una calculadora que te da las fechas exactas.',
  },
  {
    pregunta: '¿El curso para el descuento se paga aparte?',
    respuesta:
      'No. Según el artículo 136 del Código Nacional de Tránsito, si haces el curso en un Centro Integral de Atención, en una escuela de conducción o en un organismo de tránsito de otra ciudad, ese centro recibe el 25 % de lo que pagas y el resto va al organismo de tránsito donde fue la infracción. En total pagas el 50 % o el 75 % de la multa.',
  },
  ...(ejemploVigente
    ? [
        {
          pregunta: '¿Cuánto cuesta sacar el carro de los patios por Pico y Placa?',
          respuesta: `Depende de la ciudad, y se suma a la multa. En Bogotá, en ${ej.anio}, la grúa cuesta ${formatearPesos(ej.grua.carro)} para un carro y ${formatearPesos(ej.grua.moto)} para una moto, y el primer día de parqueadero ${formatearPesos(ej.patio_primer_dia.carro)} y ${formatearPesos(ej.patio_primer_dia.moto)}. Con el descuento del 50 %, sacar un carro el primer día cuesta en total ${formatearPesos(multa.conCurso5Dias + ej.grua.carro + ej.patio_primer_dia.carro)}; sin descuento, ${formatearPesos(multa.multa + ej.grua.carro + ej.patio_primer_dia.carro)}.`,
        },
      ]
    : []),
  {
    pregunta: '¿Me pueden poner la multa de Pico y Placa con cámara (fotomulta)?',
    respuesta:
      'Sí. Las cámaras autorizadas por el Ministerio de Transporte pueden detectar el Pico y Placa. El comparendo se envía por correo físico o electrónico dentro de los 3 días hábiles siguientes a su validación, a los datos que figuran en el RUNT (Ley 1843 de 2017). Por eso conviene tener la dirección y el correo actualizados.',
  },
  {
    pregunta: '¿Qué pasa si no pago la multa de Pico y Placa?',
    respuesta:
      'El comparendo queda registrado en el SIMIT y no podrás hacer trámites ante los organismos de tránsito hasta estar a paz y salvo. La autoridad puede cobrar por jurisdicción coactiva. La sanción prescribe a los 3 años contados desde la infracción, pero la presentación de la demanda de cobro interrumpe ese plazo.',
  },
  {
    pregunta: '¿La multa de Pico y Placa es igual para motos?',
    respuesta: `Sí: ${valor} en ${multa.anio}. La infracción C.14 aplica a cualquier vehículo automotor, incluidas las motos, en las ciudades donde ellas tienen Pico y Placa. Lo que cambia por ciudad es si la moto está o no cubierta por la restricción.`,
  },
  {
    pregunta: '¿Si mi carro está matriculado en otra ciudad, me aplica el Pico y Placa?',
    respuesta:
      'En general sí: la restricción aplica a los vehículos que circulan por la ciudad, sin importar dónde estén matriculados. Algunas ciudades tienen reglas distintas para placas de fuera, como Cúcuta (esquema de placa día) o Ibagué (la hora valle solo beneficia a placas locales). Revisa la página de cada ciudad.',
  },
  {
    pregunta: '¿Puedo pagar para no tener Pico y Placa?',
    respuesta:
      'Solo en Bogotá, con el Pico y Placa Solidario: un permiso diario, mensual o semestral que se paga a la Secretaría de Movilidad. En las demás ciudades no existe esa opción y la única forma legal de circular en tu día es estar exento por el decreto.',
  },
  {
    pregunta: '¿Dónde consulto si tengo comparendos?',
    respuesta:
      'En el SIMIT, el sistema nacional de la Federación Colombiana de Municipios, con la placa o la cédula; y en la página del organismo de tránsito de la ciudad donde ocurrió la infracción. Desconfía de páginas que cobran por la consulta.',
  },
];

// Ciudades con y sin Pico y Placa según los datos del sitio (el mismo JSON que
// pinta cada página de ciudad). "Con" = al menos un tipo de vehículo aplica.
const tienePyp = (c: Ciudad): boolean => Object.values(c.vehiculos).some((v) => v.aplica);
const conPyp = ciudades.filter(tienePyp);
const sinPyp = ciudades.filter((c) => !tienePyp(c));

// Ciudades cuya sanción tiene un matiz propio. El texto sale del JSON de cada
// ciudad, así que si el decreto cambia, este bloque cambia solo.
const slugsConMatices = ['quibdo', 'popayan', 'barranquilla', 'soacha'];
const conMatices = slugsConMatices
  .map((slug) => ciudades.find((c) => c.slug === slug))
  .filter((c): c is Ciudad => c !== undefined);

const faq = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: preguntas.map((p) => ({
    '@type': 'Question',
    name: p.pregunta,
    acceptedAnswer: { '@type': 'Answer', text: p.respuesta },
  })),
};

const breadcrumb = breadcrumbJsonLd([
  { nombre: 'Inicio', ruta: '/' },
  { nombre: 'Multas del Pico y Placa', ruta: '/multas-pico-y-placa' },
]);

const enlace = 'text-yellow-700 underline dark:text-yellow-400';
const tarjeta = 'rounded-lg border border-gray-200 p-4 dark:border-gray-700';
---

<Principal titulo={titulo} descripcion={descripcion} jsonLd={[breadcrumb, faq]}>
  <nav class="mb-4 text-sm text-gray-500 dark:text-gray-400" aria-label="Ruta de navegación">
    <a href="/" class="hover:underline">Inicio</a>
    <span class="mx-1">/</span>
    <span class="text-gray-700 dark:text-gray-300">Multas</span>
  </nav>

  <header class="mb-6">
    <h1 class="text-3xl font-bold sm:text-4xl">
      Multa por Pico y Placa {multa.anio}
    </h1>
    <p class="mt-2 text-gray-500 dark:text-gray-400">
      Cuánto vale en Colombia, cuánto subió, qué descuentos tiene, cómo llega la
      fotomulta y qué hacer si te ponen el comparendo. Todo con la norma que lo
      respalda.
    </p>
  </header>

  <!-- Respuesta corta: el valor, cuánto cambió y cuánto se paga con descuento -->
  <ValorMulta multa={multa} />

  <p class="-mt-3 mb-6">
    <a
      href={enlaceWhatsApp}
      target="_blank"
      rel="noopener"
      class="inline-flex items-center gap-2 rounded-lg border border-green-600 px-4 py-2 text-sm font-semibold text-green-700 transition-colors hover:bg-green-50 dark:border-green-500 dark:text-green-400 dark:hover:bg-green-950/30"
    >
      <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 20.25c4.97 0 9-3.694 9-8.25s-4.03-8.25-9-8.25S3 7.444 3 12c0 2.104.859 4.023 2.273 5.48.432.447.74 1.04.586 1.641a4.483 4.483 0 0 1-.923 1.785A5.969 5.969 0 0 0 6 21c1.282 0 2.47-.402 3.445-1.087.81.22 1.668.337 2.555.337Z" />
      </svg>
      Compartir por WhatsApp
    </a>
  </p>

  <div class="mb-8 space-y-4 text-sm leading-relaxed">
    <CalculadoraPlazos hoy={fecha} fechaSimulada={simulacionValida ? fechaParam : null} />
    <CostoInmovilizacion multa={multa} />
    <HistorialMulta multa={multa} />

    <section class={tarjeta}>
      <h2 class="text-lg font-semibold">Infracción C.14: qué dice la ley</h2>
      <p class="mt-1 text-gray-600 dark:text-gray-400">
        Circular en tu día de Pico y Placa corresponde a la infracción
        <strong>C.14</strong> del artículo 131 del Código Nacional de Tránsito.
        El texto legal es corto y no deja dudas:
      </p>
      <blockquote class="mt-2 border-l-4 border-yellow-400 pl-3 italic text-gray-700 dark:text-gray-300">
        «Transitar por sitios restringidos o en horas prohibidas por la autoridad
        competente. Además, el vehículo será inmovilizado.»
      </blockquote>
      <p class="mt-2 text-gray-600 dark:text-gray-400">
        El Código fijó las infracciones tipo C en <strong>15 salarios mínimos
        legales diarios vigentes (SMLDV)</strong>, medio salario mínimo mensual.
        Pero esa cuenta ya no es la que se cobra: desde 2020 la multa se convirtió
        en Unidades de Valor Tributario (12,33 UVT, artículo 49 de la Ley 1955 de
        2019) y desde 2024 en <strong>{formatearUnidades(cantidadUvbPorTipo.C)}
        Unidades de Valor Básico (UVB)</strong>. Por eso ya no sube con el salario
        mínimo sino con la inflación. Aplica al conductor o al propietario de
        cualquier vehículo automotor: carro, moto, taxi o camión.
      </p>
    </section>

    <section class={tarjeta}>
      <h2 class="text-lg font-semibold">¿De dónde sale el valor? (y por qué ves otras cifras)</h2>
      <p class="mt-1 text-gray-600 dark:text-gray-400">
        Desde el 1 de enero de 2024 las multas de tránsito se liquidan en
        <strong>Unidades de Valor Básico (UVB)</strong>, no en salarios mínimos
        (artículo 313 de la Ley 2294 de 2023 y
        <a href="https://www.alcaldiabogota.gov.co/sisjur/normas/Norma1.jsp?i=181493" target="_blank" rel="noopener" class={enlace}>Circular Externa 20244000000077 de 2024</a>
        del Ministerio de Transporte). La del Pico y Placa vale
        {' '}<strong>{unidades}</strong>, y el valor de cada UVB lo fija el
        Ministerio de Hacienda en diciembre para el año siguiente: para
        {' '}{multa.anio}, <strong>{valorUnidad}</strong>
        {' '}({multa.url_norma ? <a href={multa.url_norma} target="_blank" rel="noopener" class={enlace}>{multa.norma_valor_unidad}</a> : multa.norma_valor_unidad}).
      </p>
      <div class="mt-3 rounded bg-gray-50 p-3 font-mono text-xs text-gray-700 dark:bg-gray-900 dark:text-gray-300">
        {unidades} × {valorUnidad} = {formatearPesos(multa.cantidad_unidades * multa.valor_unidad)}<br />
        Aproximado a la centena = <strong>{valor}</strong>
      </div>
      <p class="mt-3 text-gray-600 dark:text-gray-400">Si en otro lado ves una cifra distinta, casi siempre es por una de estas razones:</p>
      <ul class="mt-2 list-disc space-y-1 pl-5 text-gray-600 dark:text-gray-400">
        <li><strong>Unos $100 de diferencia:</strong> la Circular del Ministerio de Transporte hizo la conversión con {formatearUnidades(cantidadUvbCircular)} UVB; Bogotá y los decretos de 2026 usan {formatearUnidades(multa.cantidad_unidades)}. Con {formatearUnidades(cantidadUvbCircular)} UVB da {formatearPesos(cantidadUvbCircular * multa.valor_unidad)}.</li>
        <li><strong>Cifras de otros años:</strong> la multa cambia cada enero y muchas páginas no se actualizan. Por ejemplo, $499.999 es lo que daban 15 salarios mínimos diarios de 2022.</li>
        <li><strong>Cálculos con el salario mínimo:</strong> la regla de los 15 salarios mínimos diarios dejó de usarse en 2020. Un valor calculado con el salario mínimo de este año da más alto y no es el que se cobra.</li>
      </ul>
      <p class="mt-2 text-gray-600 dark:text-gray-400">
        El valor exacto lo cobra el organismo de tránsito de la ciudad donde
        ocurrió la infracción. Bogotá, por ejemplo, publica su
        <a href={multa.url_fuente} target="_blank" rel="noopener" class={enlace}>tabla de autoliquidación de infracciones</a>
        cada enero. Y recuerda que la multa es solo una parte: si te
        inmovilizan, la grúa y los patios se pagan aparte (mira el ejemplo de
        Bogotá más arriba).
      </p>
    </section>

    <section class={tarjeta}>
      <h2 class="text-lg font-semibold">Dónde queda el Pico y Placa en la escala de multas</h2>
      <p class="mt-1 text-gray-600 dark:text-gray-400">
        El artículo 131 ordena las infracciones en cuatro categorías generales. El
        Pico y Placa está en la tercera, la misma de estacionar en sitio prohibido.
      </p>
      <div class="mt-3 overflow-x-auto">
        <table class="w-full text-left text-xs sm:text-sm">
          <thead>
            <tr class="border-b border-gray-200 text-gray-500 dark:border-gray-700 dark:text-gray-400">
              <th class="py-2 pr-3 font-medium">Tipo</th>
              <th class="py-2 pr-3 font-medium">{escalaEnPesos ? `Multa ${multa.anio}` : 'Multa'}</th>
              <th class="py-2 font-medium">Ejemplos</th>
            </tr>
          </thead>
          <tbody>
            {escala.map((fila) => (
              <tr class={`border-b border-gray-100 dark:border-gray-800 ${fila.esPyp ? 'bg-yellow-50 font-semibold dark:bg-yellow-950/20' : ''}`}>
                <td class="py-2 pr-3 font-mono">{fila.tipo}</td>
                <td class="py-2 pr-3 whitespace-nowrap">
                  {escalaEnPesos ? (
                    <>
                      <span class="font-mono">{formatearPesos(valores[fila.tipo])}</span>
                      <span class="block text-xs font-normal text-gray-500 dark:text-gray-400">{formatearUnidades(cantidadUvbPorTipo[fila.tipo])} UVB · {fila.smldv} SMLDV</span>
                    </>
                  ) : (
                    <span class="font-mono">{fila.smldv} SMLDV</span>
                  )}
                </td>
                <td class="py-2 text-gray-600 dark:text-gray-400">{fila.nota}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="mt-2 text-xs text-gray-500 dark:text-gray-400">
        Valores de la tabla oficial de Bogotá. Fuera de esta escala hay sanciones
        especiales con reglas propias, como las de conducir en estado de embriaguez.
      </p>
    </section>

    <section class={tarjeta}>
      <h2 class="text-lg font-semibold">Inmovilización: qué pasa con el vehículo</h2>
      <p class="mt-1 text-gray-600 dark:text-gray-400">
        Inmovilizar es suspender temporalmente la circulación del vehículo: se
        lleva en grúa a un parqueadero autorizado (los «patios») hasta que cese la
        causa (artículo 125 de la Ley 769 de 2002). En el Pico y Placa la causa
        cesa cuando termina el horario de restricción de ese día. Tres cosas que
        conviene saber:
      </p>
      <ul class="mt-2 list-disc space-y-1 pl-5 text-gray-600 dark:text-gray-400">
        <li><strong>La grúa y los patios los paga el propietario</strong>, con las tarifas que fija la autoridad de tránsito de cada ciudad. Son <strong>adicionales</strong> al comparendo.</li>
        <li>Al entrar y al salir de los patios se hace un <strong>inventario</strong> del vehículo y de lo que lleva dentro. Revísalo y guárdalo: si falta algo, el parqueadero responde.</li>
        <li>Para retirar el vehículo hay que resolver primero el comparendo (aceptarlo y pagar, o iniciar el trámite) y presentar los documentos del vehículo ante el organismo de tránsito.</li>
      </ul>
    </section>

    <section class={tarjeta}>
      <h2 class="text-lg font-semibold">Descuentos por pronto pago</h2>
      <p class="mt-1 text-gray-600 dark:text-gray-400">
        Si aceptas la infracción, el artículo 136 de la Ley 769 de 2002 (modificado
        por el
        <a href="https://www.funcionpublica.gov.co/eva/gestornormativo/norma.php?i=103352" target="_blank" rel="noopener" class={enlace}>Decreto 2106 de 2019</a>)
        te da dos ventanas de descuento. En las dos es obligatorio hacer un
        <strong>curso sobre normas de tránsito</strong> en un organismo de tránsito,
        un centro de enseñanza automovilística o un centro integral de atención
        registrados en el RUNT (también puede ser virtual).
      </p>
      <div class="mt-3 grid gap-2 sm:grid-cols-3">
        <div class="rounded border border-green-300 bg-green-50 p-3 dark:border-green-800 dark:bg-green-950/20">
          <p class="text-xs text-gray-500 dark:text-gray-400">Dentro de los 5 días hábiles</p>
          <p class="text-xl font-bold text-green-700 dark:text-green-400">Pagas el 50 %</p>
          <p class="text-xs text-gray-600 dark:text-gray-400">{con5} con curso</p>
        </div>
        <div class="rounded border border-yellow-300 bg-yellow-50 p-3 dark:border-yellow-800 dark:bg-yellow-950/20">
          <p class="text-xs text-gray-500 dark:text-gray-400">Del día 6 al 20 hábil</p>
          <p class="text-xl font-bold text-yellow-700 dark:text-yellow-400">Pagas el 75 %</p>
          <p class="text-xs text-gray-600 dark:text-gray-400">{con20} con curso</p>
        </div>
        <div class="rounded border border-red-300 bg-red-50 p-3 dark:border-red-800 dark:bg-red-950/20">
          <p class="text-xs text-gray-500 dark:text-gray-400">Después, o si pierdes la audiencia</p>
          <p class="text-xl font-bold text-red-700 dark:text-red-400">Pagas el 100 %</p>
          <p class="text-xs text-gray-600 dark:text-gray-400">{valor}, sin descuento</p>
        </div>
      </div>
      <p class="mt-3 text-gray-600 dark:text-gray-400">
        Los plazos se cuentan en <strong>días hábiles</strong> (sin sábados,
        domingos ni festivos) desde el día siguiente al comparendo. Si es
        fotomulta, corren desde que te llega la notificación: 11 días hábiles
        para el 50 % y hasta el día 26 para el 75 %. Así lo explican las guías
        oficiales de
        <a href="https://bogota.gov.co/mi-ciudad/movilidad/bogota-plazos-para-obtener-descuentos-en-los-comparendos-de-transito" target="_blank" rel="noopener" class={enlace}>Bogotá</a>
        y
        <a href="https://www.medellin.gov.co/es/sala-de-prensa/noticias/conoce-los-descuentos-para-el-pago-de-multas/" target="_blank" rel="noopener" class={enlace}>Medellín</a>.
        Usa la <a href="#calculadora" class={enlace}>calculadora</a> para ver tus
        fechas y confirma el conteo con el organismo de tránsito de tu ciudad
        antes de dejar pasar un día.
      </p>
      <p class="mt-2 text-gray-600 dark:text-gray-400">
        <strong>El curso no se paga aparte.</strong> Si lo haces en un Centro
        Integral de Atención (CIA), en una escuela de conducción o en un organismo
        de tránsito de otra ciudad, ese centro recibe el 25 % de lo que pagas y el
        resto va al organismo de tránsito donde fue la infracción (artículo 136).
        En total pagas el 50 % o el 75 % de la multa.
      </p>
    </section>

    <section class={tarjeta}>
      <h2 class="text-lg font-semibold">Fotomultas: la cámara también ve el Pico y Placa</h2>
      <p class="mt-1 text-gray-600 dark:text-gray-400">
        Las cámaras de fotodetección autorizadas por el Ministerio de Transporte
        pueden registrar la infracción C.14 sin que ningún agente te detenga. La
        <a href="https://www.alcaldiabogota.gov.co/sisjur/normas/Norma1.jsp?i=69928" target="_blank" rel="noopener" class={enlace}>Ley 1843 de 2017</a>
        fija las reglas del juego:
      </p>
      <ul class="mt-2 list-disc space-y-1 pl-5 text-gray-600 dark:text-gray-400">
        <li>El comparendo se envía <strong>por correo físico o electrónico</strong> dentro de los <strong>3 días hábiles</strong> siguientes a su validación por la autoridad, a los datos del propietario en el RUNT. Si tu dirección o tu correo están desactualizados, la multa puede llegar tarde o no llegar, y eso no la borra.</li>
        <li>Si no te notificaron o lo hicieron mal, los plazos de descuento empiezan a correr <strong>desde la notificación efectiva</strong>, no desde la foto.</li>
        <li>La Corte Constitucional (sentencia C-038 de 2020) tumbó la responsabilidad automática del propietario: la autoridad debe vincular al proceso a quien conducía. En la práctica, el propietario recibe la notificación y puede controvertirla.</li>
        <li>Con cámara no hay inmovilización en el momento, pero la multa es la misma: {valor} en {multa.anio}.</li>
      </ul>
    </section>

    <section class={tarjeta}>
      <h2 class="text-lg font-semibold">Te llegó un comparendo por Pico y Placa: paso a paso</h2>
      <ol class="mt-2 list-decimal space-y-2 pl-5 text-gray-600 dark:text-gray-400">
        <li><strong>Revisa los datos.</strong> Código C.14, placa, fecha, hora y lugar. Entra a la página de tu ciudad y comprueba si ese día, a esa hora, la restricción de verdad aplicaba a tu placa y a tu tipo de vehículo.</li>
        <li><strong>Si estaba bien puesto, acéptalo y paga con descuento.</strong> 50 % dentro de los 5 días hábiles ({con5}) o 75 % hasta el día 20 ({con20}), siempre con el curso. Cada día que pasa te acerca al 100 % ({valor}). La <a href="#calculadora" class={enlace}>calculadora</a> te da tus fechas exactas.</li>
        <li><strong>Si crees que está mal, no lo aceptes y pide audiencia.</strong> Vehículo exento, vía exenta, medida suspendida ese día o placa mal leída son razones válidas. Lleva pruebas: el decreto, la documentación del vehículo, fotos. Si te declaran responsable, pagas el 100 %.</li>
        <li><strong>No dejes pasar los plazos.</strong> La ley pide presentarse ante la autoridad dentro de los 3 días hábiles siguientes al comparendo; si no compareces sin justa causa, prevé que la multa aumente hasta el doble (artículo 135).</li>
        <li><strong>Después de pagar, verifica en el SIMIT</strong> que el comparendo figure saldado. Guarda el recibo y el certificado del curso.</li>
      </ol>
    </section>

    <section class={tarjeta}>
      <h2 class="text-lg font-semibold">¿Y si no pago? Cobro, bloqueo de trámites y prescripción</h2>
      <ul class="mt-2 list-disc space-y-1 pl-5 text-gray-600 dark:text-gray-400">
        <li>El comparendo queda registrado en el <strong>SIMIT</strong> y, mientras no estés a paz y salvo, los organismos de tránsito no te hacen trámites: traspasos, licencia de conducción, matrículas (artículo 10 de la Ley 769 de 2002).</li>
        <li>La autoridad de tránsito de la ciudad donde ocurrió el hecho puede cobrar por <strong>jurisdicción coactiva</strong>, es decir, como se cobra un impuesto.</li>
        <li>La sanción <strong>prescribe en 3 años</strong> contados desde la infracción, pero la presentación de la demanda de cobro interrumpe ese plazo (artículo 159). No cuentes con que se borre sola.</li>
      </ul>
    </section>

    <section class={tarjeta}>
      <h2 class="text-lg font-semibold">Consulta si tienes comparendos pendientes</h2>
      <p class="mt-1 text-gray-600 dark:text-gray-400">
        El
        <a href="https://www.fcm.org.co/simit/" target="_blank" rel="noopener" class={enlace}>SIMIT</a>
        (Sistema Integrado de Información sobre Multas y Sanciones por Infracciones
        de Tránsito), de la Federación Colombiana de Municipios, consolida los
        comparendos de todo el país. Se consulta gratis con la placa o la cédula.
        La página del organismo de tránsito de cada ciudad muestra el detalle y
        permite pagar. Desconfía de sitios que cobran por «consultar» o que piden
        datos de tarjetas antes de mostrar nada.
      </p>
    </section>

    <section class={tarjeta}>
      <h2 class="text-lg font-semibold">Base legal</h2>
      <ul class="mt-2 list-disc space-y-1 pl-5 text-gray-600 dark:text-gray-400">
        <li>
          <a href="https://www.funcionpublica.gov.co/eva/gestornormativo/norma.php?i=5557" target="_blank" rel="noopener" class={enlace}>Ley 769 de 2002 (Código Nacional de Tránsito)</a>:
          artículo 131 C.14 (la infracción), 125 (inmovilización), 135 (procedimiento del comparendo), 136 (descuentos), 159 (prescripción) y 10 (SIMIT). Modificada por la Ley 1383 de 2010 y el Decreto 2106 de 2019.
        </li>
        <li>Ley 1843 de 2017: detección de infracciones con cámaras y notificación del comparendo.</li>
        <li>Ley 1955 de 2019, artículo 49: paso de las multas de salarios mínimos a UVT (2020 a 2023).</li>
        <li>Ley 2294 de 2023, artículo 313, y Circular Externa 20244000000077 de 2024 del Ministerio de Transporte: liquidación de las multas en UVB.</li>
        <li>{multa.norma_valor_unidad}: valor de la UVB para {multa.anio} ({valorUnidad}).</li>
        <li>
          <a href={multa.url_fuente} target="_blank" rel="noopener" class={enlace}>{multa.fuente}</a>: valor en pesos de cada infracción.
        </li>
        <li>El decreto de Pico y Placa de cada ciudad, que define días, horarios, placas y excepciones. Lo citamos en cada página de ciudad.</li>
      </ul>
    </section>

    <div class="rounded-lg border border-yellow-300 bg-yellow-50 p-4 dark:border-yellow-700 dark:bg-yellow-950/20">
      <strong>Aviso:</strong> esta información es de carácter general e
      informativo, no es asesoría legal. El valor puede variar unos pesos entre
      ciudades por redondeo, y el conteo de los plazos y los procedimientos
      cambian de una ciudad a otra. Consulta el organismo de tránsito de tu
      ciudad para tu caso particular.
    </div>
  </div>

  <section class="mb-8">
    <h2 class="mb-3 text-xl font-bold">Cómo evitar la multa sin romper la norma</h2>
    <div class="grid gap-3 sm:grid-cols-2">
      <a href="/" class={`${tarjeta} block transition-colors hover:border-yellow-400`}>
        <h3 class="font-semibold">Revisa antes de salir</h3>
        <p class="mt-1 text-sm text-gray-600 dark:text-gray-400">Guarda el último número de tu placa en la página de tu ciudad y el sitio te dice de primero si hoy circulas. También puedes descargar tus días al calendario del celular, con alarma la noche anterior.</p>
      </a>
      <a href="/exenciones-pico-y-placa" class={`${tarjeta} block transition-colors hover:border-yellow-400`}>
        <h3 class="font-semibold">Verifica si estás exento</h3>
        <p class="mt-1 text-sm text-gray-600 dark:text-gray-400">Vehículos eléctricos, de personas con discapacidad, de emergencia y otros quedan por fuera en muchas ciudades. Cada decreto trae su propia lista.</p>
      </a>
      <a href="/medellin" class={`${tarjeta} block transition-colors hover:border-yellow-400`}>
        <h3 class="font-semibold">Usa las vías exentas</h3>
        <p class="mt-1 text-sm text-gray-600 dark:text-gray-400">Algunas ciudades dejan libres corredores concretos. En Medellín y el Valle de Aburrá los mostramos sobre el mapa, tramo por tramo.</p>
      </a>
      <a href="/bogota" class={`${tarjeta} block transition-colors hover:border-yellow-400`}>
        <h3 class="font-semibold">Pico y Placa Solidario (solo Bogotá)</h3>
        <p class="mt-1 text-sm text-gray-600 dark:text-gray-400">Es la única ciudad donde se puede pagar un permiso diario, mensual o semestral para circular en tu día. En el resto del país no existe.</p>
      </a>
    </div>
  </section>

  {conMatices.length > 0 && (
    <section class="mb-8">
      <h2 class="mb-3 text-xl font-bold">Ciudades donde la sanción tiene un matiz propio</h2>
      <ul class="space-y-2 text-sm">
        {conMatices.map((c) => (
          <li class={tarjeta}>
            <a href={`/${c.slug}#sanciones`} class="font-semibold hover:underline">{c.nombre}</a>
            <p class="mt-1 text-gray-600 dark:text-gray-400">{c.sanciones.descripcion}</p>
          </li>
        ))}
      </ul>
    </section>
  )}

  <section class="mb-8">
    <h2 class="mb-2 text-xl font-bold">La sanción en tu ciudad</h2>
    <p class="mb-3 text-sm text-gray-600 dark:text-gray-400">
      La multa es nacional: {valor} en {multa.anio} en todas las ciudades con
      Pico y Placa, salvo diferencias de redondeo de unos pesos. Lo que cambia es
      si en tu ciudad hay Pico y Placa, para qué vehículos y en qué horario. Toca
      tu ciudad para ver su sanción y su decreto.
    </p>
    <div class="flex flex-wrap gap-2">
      {conPyp.map((c) => (
        <a
          href={`/${c.slug}#sanciones`}
          class="rounded-full border border-gray-200 px-3 py-1.5 text-sm transition-colors hover:border-yellow-400 hover:bg-yellow-50 dark:border-gray-700 dark:hover:bg-yellow-950/20"
        >
          {c.nombre}
        </a>
      ))}
    </div>
    {sinPyp.length > 0 && (
      <p class="mt-4 text-sm text-gray-600 dark:text-gray-400">
        <strong>Sin Pico y Placa hoy:</strong>{' '}
        {sinPyp.map((c, i) => (
          <>
            <a href={`/${c.slug}`} class="hover:underline">{c.nombre}</a>{i < sinPyp.length - 1 ? ', ' : '.'}
          </>
        ))}
        {' '}Ahí no hay sanción por circular según la placa, pero sí por otras restricciones que estén vigentes.
      </p>
    )}
  </section>

  <section class="mb-8">
    <h2 class="mb-3 text-xl font-bold">Preguntas frecuentes sobre la multa</h2>
    <div class="space-y-3">
      {preguntas.map((p) => (
        <details class="rounded-lg border border-gray-200 p-4 dark:border-gray-700">
          <summary class="cursor-pointer font-semibold">{p.pregunta}</summary>
          <p class="mt-2 text-sm text-gray-600 dark:text-gray-400">{p.respuesta}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="mb-4">
    <h2 class="mb-2 text-lg font-bold">También te puede interesar</h2>
    <ul class="space-y-1 text-sm">
      <li>
        <a href="/exenciones-pico-y-placa" class="text-yellow-700 hover:underline dark:text-yellow-400">
          ¿Qué vehículos están exentos del Pico y Placa?
        </a>
      </li>
      <li>
        <a href="/preguntas-frecuentes" class="text-yellow-700 hover:underline dark:text-yellow-400">
          Preguntas frecuentes sobre el Pico y Placa
        </a>
      </li>
      <li>
        <a href="/pico-y-placa-manana" class="text-yellow-700 hover:underline dark:text-yellow-400">
          ¿Qué placas tienen Pico y Placa mañana?
        </a>
      </li>
    </ul>
  </section>
</Principal>
