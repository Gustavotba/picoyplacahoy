---
import Principal from '../../layouts/Principal.astro';
import Reloj from '../../components/Reloj.astro';
import MapaViasExentas from '../../components/MapaViasExentas.astro';
import { obtenerCiudad, obtenerSlugs, tiposVehiculo, ciudades } from '../../lib/ciudades';

// GeoJSON de vías exentas por ciudad
import medellinGeo from '../../data/ciudades/medellin.geo.json';
const geodatos: Record<string, unknown> = { medellin: medellinGeo };
const centrosMapa: Record<string, { centro: [number, number]; zoom: number }> = {
  medellin: { centro: [6.2442, -75.5812], zoom: 13 },
};
import {
  calcularPicoPlaca,
  calcularProximosDias,
  fechaColombia,
  formatearFechaColombia,
  formatearISO,
  DIAS_LEGIBLES,
  CRITERIO_LEGIBLE,
} from '../../lib/calcular';
import {
  ETIQUETAS_VEHICULO,
  ICONOS_VEHICULO,
  esPlaceholder,
  esSemanalPorDia,
  esQuincenalPorFecha,
  esSinRestriccion,
} from '../../lib/tipos';
import type { TipoVehiculo } from '../../lib/tipos';
import { breadcrumbJsonLd } from '../../lib/seo';

export const prerender = false;

const { ciudad: slugCiudad, tipo: tipoParam } = Astro.params;
const ciudad = obtenerCiudad(slugCiudad!);
const tipo = tipoParam as TipoVehiculo;

if (!ciudad || !tiposVehiculo.includes(tipo)) {
  return Astro.redirect('/');
}

const vehiculo = ciudad.vehiculos[tipo];
const fechaParam = Astro.url.searchParams.get('fecha');
const hoy = fechaParam ? new Date(fechaParam + 'T12:00:00') : fechaColombia();
const esDebug = !!fechaParam;
const resultado = calcularPicoPlaca(ciudad, tipo, hoy);
const etiqueta = ETIQUETAS_VEHICULO[tipo];
const icono = ICONOS_VEHICULO[tipo];
const fechaFormateada = formatearFechaColombia(hoy);
const proximosDias = calcularProximosDias(ciudad, tipo, hoy, 30);

const tieneViasExentas = ciudad.vias_exentas && ciudad.vias_exentas.length > 0;
const tieneExenciones = ciudad.exenciones_generales && ciudad.exenciones_generales.length > 0;
const contacto = ciudad.contacto_ciudadano;
const tieneWeb = !!contacto?.secretaria_movilidad && contacto.secretaria_movilidad !== 'pendiente_verificar';
const tieneTwitter = !!contacto?.twitter;
const tieneFacebook = !!contacto?.facebook;
const tieneTelefono = !!contacto?.linea_atencion && contacto.linea_atencion !== 'pendiente_verificar';
const tieneContacto = !!contacto && (tieneWeb || tieneTwitter || tieneFacebook || tieneTelefono);
const tieneSancionesDetalladas = ciudad.sanciones.valor_aproximado_pesos !== undefined;
const esVehiculoSemanal = esSemanalPorDia(vehiculo);
const esVehiculoQuincenal = esQuincenalPorFecha(vehiculo);
const esVehiculoInactivo = esSinRestriccion(vehiculo);
const esVehiculoPlaceholder = esPlaceholder(vehiculo);

const vehiculoTieneViasExentas = 'aplican_vias_exentas' in vehiculo && vehiculo.aplican_vias_exentas === true;
const mapaEnDetalle = vehiculoTieneViasExentas && ciudad.slug in centrosMapa && ciudad.slug in geodatos;
const mapaConfig = mapaEnDetalle ? centrosMapa[ciudad.slug] : null;
const mapaGeojson = mapaEnDetalle ? geodatos[ciudad.slug] : null;

const diasSemana = ['lunes', 'martes', 'miercoles', 'jueves', 'viernes'] as const;

const ciudadSinPyP = ciudad.decreto_actual === 'No aplica';
const tipoSinRestriccion = !vehiculo.aplica;

// Otros tipos de vehículo para internal linking
const otrosTipos = tiposVehiculo.filter((t) => t !== tipo);

// Otras ciudades para internal linking
const otrasCiudades = ciudades.filter((c) => c.slug !== ciudad.slug);

// Ciudades que SÍ tienen PyP para este tipo de vehículo
const ciudadesConPyPParaTipo = ciudades
  .filter((c) => c.slug !== ciudad.slug && c.vehiculos[tipo]?.aplica)
  .slice(0, 10);

// URL de la Ley 769 de 2002
const URL_LEY_769 = 'https://www.funcionpublica.gov.co/eva/gestornormativo/norma.php?i=5557';

// Lógica de placa hero (misma que TarjetaVehiculo)
const criterioTexto = resultado.criterioPlaca ? CRITERIO_LEGIBLE[resultado.criterioPlaca] : '';
let placaTexto = '';
let placaEstilo: 'aplica' | 'libre' | 'pendiente' | 'desactualizado' | 'sin_restriccion' = 'libre';
if (resultado.datosDesactualizados) { placaTexto = '—'; placaEstilo = 'desactualizado'; }
else if (resultado.esPendiente) { placaTexto = '?'; placaEstilo = 'pendiente'; }
else if (resultado.aplica && resultado.placasRestringidas.length > 0) { placaTexto = resultado.placasRestringidas.join(' y '); placaEstilo = 'aplica'; }
else if (!resultado.aplica && resultado.horarioTexto === '' && !resultado.esFestivo && !resultado.esDiaHabil) { placaTexto = 'SIN RESTRICCIÓN'; placaEstilo = 'sin_restriccion'; }
else { placaTexto = 'LIBRE'; placaEstilo = 'libre'; }

const estilosPlaca: Record<string, { fondo: string; texto: string; borde: string }> = {
  aplica:          { fondo: 'bg-yellow-400',  texto: 'text-black',      borde: 'border-black' },
  libre:           { fondo: 'bg-green-500',   texto: 'text-white',      borde: 'border-green-700' },
  pendiente:       { fondo: 'bg-gray-300 dark:bg-gray-600', texto: 'text-gray-500 dark:text-gray-300', borde: 'border-gray-400 dark:border-gray-500' },
  desactualizado:  { fondo: 'bg-orange-300 dark:bg-orange-700', texto: 'text-orange-700 dark:text-orange-200', borde: 'border-orange-500' },
  sin_restriccion: { fondo: 'bg-green-500',   texto: 'text-white',      borde: 'border-green-700' },
};
const ep = estilosPlaca[placaEstilo];

const titulo = tipoSinRestriccion
  ? `${etiqueta} en ${ciudad.nombre} sin Pico y Placa | Puedes circular cualquier día`
  : `Pico y Placa ${etiqueta} hoy en ${ciudad.nombre} — Horarios y Placas`;
const descripcion = tipoSinRestriccion
  ? `En ${ciudad.nombre} no hay Pico y Placa para ${etiqueta.toLowerCase()}. Puedes circular cualquier día sin restricción.`
  : `Pico y Placa para ${etiqueta.toLowerCase()} en ${ciudad.nombre}: horarios, placas restringidas, sanciones y canales oficiales.`;

// Datos estructurados: servicio + rastro de migas
const servicioJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'GovernmentService',
  name: `Pico y Placa para ${etiqueta} en ${ciudad.nombre}`,
  serviceType: 'Restricción vehicular',
  areaServed: { '@type': 'City', name: ciudad.nombre },
  provider: { '@type': 'GovernmentOrganization', name: ciudad.autoridad, url: ciudad.autoridad_web },
};
const breadcrumb = breadcrumbJsonLd([
  { nombre: 'Inicio', ruta: '/' },
  { nombre: ciudad.nombre, ruta: `/${ciudad.slug}` },
  { nombre: etiqueta, ruta: `/${ciudad.slug}/${tipo}` },
]);
const bloquesJsonLd = [servicioJsonLd, breadcrumb];
---

<Principal titulo={titulo} descripcion={descripcion} jsonLd={bloquesJsonLd}>

  {esDebug && (
    <div class="mb-4 rounded-lg border-2 border-dashed border-purple-400 bg-purple-50 px-4 py-2 text-sm text-purple-700 dark:bg-purple-950/30 dark:text-purple-300">
      Modo debug: simulando fecha <strong>{fechaParam}</strong> · <a href={`/${ciudad.slug}/${tipo}`} class="underline">Volver a hoy</a>
    </div>
  )}

  <!-- Breadcrumb -->
  <nav class="mb-4 text-sm">
    <a href="/" class="text-yellow-600 hover:underline">Ciudades</a>
    <span class="text-gray-400 mx-1">/</span>
    <a href={`/${ciudad.slug}`} class="text-yellow-600 hover:underline">{ciudad.nombre}</a>
    <span class="text-gray-400 mx-1">/</span>
    <span class="text-gray-500 dark:text-gray-400">{etiqueta}</span>
  </nav>

  <!-- H1 -->
  <header class="mb-6 text-center">
    <h1 class="text-2xl sm:text-3xl font-bold">
      {tipoSinRestriccion
        ? <>{etiqueta} en <a href={`/${ciudad.slug}`} class="text-green-500 hover:text-green-400 hover:underline">{ciudad.nombre}</a> sin Pico y Placa</>
        : <>{etiqueta} — <a href={`/${ciudad.slug}`} class="text-yellow-500 hover:text-yellow-400 hover:underline">{ciudad.nombre}</a></>}
    </h1>
    <p class="mt-1 text-sm text-gray-500 dark:text-gray-400 capitalize">{fechaFormateada}</p>
  </header>

  {!tipoSinRestriccion && <section class="mb-6"><Reloj /></section>}

  {/* === TIPO SIN RESTRICCIÓN === */}
  {tipoSinRestriccion && (
    <>
      <section class="mb-8 rounded-xl border-2 border-green-300 bg-green-50 dark:border-green-700 dark:bg-green-950/20 p-8 text-center">
        <div class="flex justify-center mb-4">
          <div class="flex h-16 w-16 items-center justify-center rounded-xl bg-white/90 dark:bg-gray-800 p-2.5 shadow-sm">
            <img src={icono} alt={etiqueta} class="h-full w-full object-contain" />
          </div>
        </div>
        <p class="text-3xl sm:text-4xl font-black text-green-600 dark:text-green-400 mb-3">SIN RESTRICCIÓN</p>
        <p class="text-lg text-gray-600 dark:text-gray-400">
          En {ciudad.nombre}, los vehículos tipo {etiqueta.toLowerCase()} pueden circular cualquier día sin restricción de Pico y Placa.
        </p>
        {esVehiculoInactivo && 'nota' in vehiculo && vehiculo.nota && (
          <p class="mt-3 text-sm text-gray-500 dark:text-gray-400 italic">{vehiculo.nota}</p>
        )}
      </section>

      {ciudadesConPyPParaTipo.length > 0 && (
        <section class="mb-6">
          <h2 class="text-lg font-bold mb-3">Ciudades con Pico y Placa para {etiqueta}</h2>
          <div class="grid grid-cols-2 sm:grid-cols-3 gap-2">
            {ciudadesConPyPParaTipo.map((c) => (
              <a href={`/${c.slug}/${tipo}`}
                class="rounded-lg border border-yellow-200 dark:border-yellow-800 px-3 py-2.5 text-sm font-medium text-center hover:border-yellow-400 hover:bg-yellow-50 dark:hover:bg-yellow-950/20 transition-colors">
                {c.nombre}
              </a>
            ))}
          </div>
        </section>
      )}
    </>
  )}

  {/* === TIPO CON RESTRICCIÓN === */}
  {!tipoSinRestriccion && (<>
  <section class="mb-8 flex justify-center">
    <div class="w-full max-w-md flex flex-col overflow-hidden rounded-xl shadow-lg">
      {/* Cabecera azul */}
      <div class="flex items-center justify-center gap-3 bg-blue-600 px-4 py-4">
        <div class="flex h-16 w-16 shrink-0 items-center justify-center rounded-xl bg-white/90 p-2.5">
          <img src={icono} alt={etiqueta} class="h-full w-full object-contain" />
        </div>
        <h2 class:list={[
          'font-bold uppercase tracking-wide text-white',
          tipo === 'transporte_carga' ? 'text-base sm:text-lg' : 'text-lg sm:text-xl',
        ]}>
          {etiqueta}
        </h2>
      </div>

      {/* Cuerpo con placa */}
      <div class="flex flex-1 flex-col items-center bg-white px-4 py-6 dark:bg-gray-900">
        <p class:list={[
          'text-sm font-semibold mb-4',
          resultado.datosDesactualizados ? 'text-orange-600 dark:text-orange-400'
            : resultado.esPendiente ? 'text-gray-500 dark:text-gray-400'
            : resultado.aplica ? 'text-red-600 dark:text-red-400'
            : 'text-green-600 dark:text-green-400',
        ]}>
          {resultado.datosDesactualizados ? 'Datos desactualizados'
            : resultado.esPendiente ? 'Pendiente de verificar'
            : resultado.aplica ? 'Hoy aplica Pico y Placa'
            : resultado.esFestivo ? 'Hoy es festivo — No aplica'
            : !resultado.esDiaHabil && resultado.horarioTexto ? 'Hoy no aplica (fin de semana)'
            : 'Hoy no aplica Pico y Placa'}
        </p>

        <div class={`w-full max-w-[260px] rounded-lg border-4 ${ep.borde} ${ep.fondo} px-5 py-4 text-center`}>
          {criterioTexto && placaEstilo === 'aplica' && (
            <p class="text-[10px] font-medium uppercase tracking-wider text-black/60 mb-1">
              {criterioTexto}
            </p>
          )}
          <p class:list={[
            'font-mono font-black leading-none',
            ep.texto,
            placaEstilo === 'aplica' ? 'text-6xl' : '',
            placaEstilo === 'libre' ? 'text-4xl' : '',
            placaEstilo === 'sin_restriccion' ? 'text-xl' : '',
            placaEstilo === 'pendiente' ? 'text-6xl' : '',
            placaEstilo === 'desactualizado' ? 'text-5xl' : '',
          ]}>
            {placaTexto}
          </p>
        </div>

        {resultado.horarioTexto && !resultado.esPendiente && !resultado.datosDesactualizados && (
          <p class="mt-4 text-sm text-gray-500 dark:text-gray-400">
            {resultado.horarioTexto}
          </p>
        )}

        {resultado.esFestivo && !resultado.aplica && (
          <p class="mt-2 text-xs text-blue-600 dark:text-blue-400 font-medium">
            Hoy es festivo en Colombia
          </p>
        )}
      </div>

      {/* Pie: volver a la ciudad */}
      <a href={`/${ciudad.slug}`} class="bg-gray-50 px-4 py-2.5 text-center dark:bg-gray-800 hover:bg-yellow-50 dark:hover:bg-yellow-950/20 transition-colors">
        <span class="text-xs font-semibold text-yellow-700 dark:text-yellow-500">
          ← Volver a {ciudad.nombre}
        </span>
      </a>
    </div>
  </section>

  {/* Secciones detalladas solo si hay datos reales */}
  {!esVehiculoInactivo && !esVehiculoPlaceholder && (
    <>
      <!-- Horario -->
      {resultado.horarioTexto && (
        <section class="mb-6 rounded-lg border border-yellow-300 bg-yellow-50 p-4 dark:bg-yellow-950/20 dark:border-yellow-700">
          <h2 class="font-bold text-sm text-gray-700 dark:text-gray-300 mb-1">Horario de la restricción</h2>
          <p class="text-2xl font-bold text-yellow-700 dark:text-yellow-300">
            {resultado.horarioTexto}
          </p>
        </section>
      )}

      <!-- Calendario clicable -->
      <section class="mb-8">
        <h2 class="text-xl font-bold mb-3">Próximos días</h2>

        <div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-7 gap-2">
          {proximosDias.slice(0, 7).map((dia) => {
            const fechaISO = formatearISO(dia.fecha);
            const href = dia.esHoy ? undefined : `/${ciudad.slug}/${tipo}?fecha=${fechaISO}`;
            const Tag = dia.esHoy ? 'div' : 'a';
            return (
              <Tag
                href={href}
                class:list={[
                  'rounded-lg border-2 flex flex-col items-center py-3 px-2 min-h-[110px] justify-between',
                  dia.esHoy ? 'ring-3 ring-yellow-400 ring-offset-1' : 'hover:scale-105 hover:shadow-lg transition-all cursor-pointer',
                  dia.resultado.datosDesactualizados
                    ? 'border-orange-200 bg-orange-50 dark:border-orange-700 dark:bg-orange-950/10'
                    : dia.resultado.aplica
                      ? 'border-yellow-300 bg-yellow-50 dark:border-yellow-700 dark:bg-yellow-950/20'
                      : (!dia.resultado.esDiaHabil || dia.resultado.esFestivo)
                        ? 'border-gray-200 bg-gray-50 dark:border-gray-700 dark:bg-gray-800'
                        : 'border-green-200 bg-green-50 dark:border-green-700 dark:bg-green-950/10',
                ]}
              >
                <p class="text-xs font-bold uppercase tracking-wider text-gray-500 dark:text-gray-400 capitalize">
                  {dia.esHoy ? 'Hoy' : dia.diaCorto}
                </p>
                <div class="text-center my-1">
                  <p class="text-2xl font-bold leading-none">{dia.numeroDia}</p>
                  <p class="text-xs text-gray-400 capitalize">{dia.mesCorto}</p>
                </div>
                <div class="text-center">
                  {dia.resultado.datosDesactualizados ? (
                    <span class="text-xs text-orange-500">—</span>
                  ) : dia.resultado.aplica ? (
                    <p class="font-mono font-black text-lg text-black dark:text-yellow-300 bg-yellow-400 dark:bg-yellow-600 rounded px-2 py-0.5">
                      {dia.resultado.placasRestringidas.join('·')}
                    </p>
                  ) : dia.resultado.esFestivo ? (
                    <span class="text-xs font-semibold text-blue-500">Festivo</span>
                  ) : !dia.resultado.esDiaHabil ? (
                    <span class="text-xs font-semibold text-gray-400">Finde</span>
                  ) : (
                    <span class="text-xs font-bold text-green-600 dark:text-green-400">Libre</span>
                  )}
                </div>
              </Tag>
            );
          })}
        </div>

        <details class="mt-2 group">
          <summary class="cursor-pointer list-none">
            <div class="flex items-center justify-center gap-2 rounded-lg border-2 border-dashed border-yellow-400 bg-yellow-50 dark:bg-yellow-950/20 px-4 py-2.5 text-sm font-bold text-yellow-700 dark:text-yellow-400 hover:bg-yellow-100 dark:hover:bg-yellow-950/40 transition-colors">
              <span class="group-open:hidden">Ver próximos 30 días ↓</span>
              <span class="hidden group-open:inline">Mostrar solo 7 días ↑</span>
            </div>
          </summary>
          <div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-7 gap-2 mt-2">
            {proximosDias.slice(7).map((dia) => {
              const fechaISO = formatearISO(dia.fecha);
              return (
                <a
                  href={`/${ciudad.slug}/${tipo}?fecha=${fechaISO}`}
                  class:list={[
                    'rounded-lg border-2 flex flex-col items-center py-3 px-2 min-h-[110px] justify-between hover:scale-105 hover:shadow-lg transition-all',
                    dia.resultado.datosDesactualizados
                      ? 'border-orange-200 bg-orange-50 dark:border-orange-700 dark:bg-orange-950/10'
                      : dia.resultado.aplica
                        ? 'border-yellow-300 bg-yellow-50 dark:border-yellow-700 dark:bg-yellow-950/20'
                        : (!dia.resultado.esDiaHabil || dia.resultado.esFestivo)
                          ? 'border-gray-200 bg-gray-50 dark:border-gray-700 dark:bg-gray-800'
                          : 'border-green-200 bg-green-50 dark:border-green-700 dark:bg-green-950/10',
                  ]}
                >
                  <p class="text-xs font-bold uppercase tracking-wider text-gray-500 dark:text-gray-400 capitalize">
                    {dia.diaCorto}
                  </p>
                  <div class="text-center my-1">
                    <p class="text-2xl font-bold leading-none">{dia.numeroDia}</p>
                    <p class="text-xs text-gray-400 capitalize">{dia.mesCorto}</p>
                  </div>
                  <div class="text-center">
                    {dia.resultado.datosDesactualizados ? (
                      <span class="text-xs text-orange-500">—</span>
                    ) : dia.resultado.aplica ? (
                      <p class="font-mono font-black text-lg text-black dark:text-yellow-300 bg-yellow-400 dark:bg-yellow-600 rounded px-2 py-0.5">
                        {dia.resultado.placasRestringidas.join('·')}
                      </p>
                    ) : dia.resultado.esFestivo ? (
                      <span class="text-xs font-semibold text-blue-500">Festivo</span>
                    ) : !dia.resultado.esDiaHabil ? (
                      <span class="text-xs font-semibold text-gray-400">Finde</span>
                    ) : (
                      <span class="text-xs font-bold text-green-600 dark:text-green-400">Libre</span>
                    )}
                  </div>
                </a>
              );
            })}
          </div>
        </details>
      </section>

      <!-- Rotación semanal -->
      {esVehiculoSemanal && (
        <section class="mb-8">
          <h2 class="text-xl font-bold mb-3">Rotación semanal completa</h2>
          <div class="overflow-x-auto rounded-lg border border-gray-200 dark:border-gray-700">
            <table class="w-full text-sm">
              <thead>
                <tr class="bg-gray-50 dark:bg-gray-800">
                  <th class="py-3 px-4 text-left font-semibold">Día</th>
                  <th class="py-3 px-4 text-left font-semibold">Placas restringidas</th>
                </tr>
              </thead>
              <tbody>
                {diasSemana.map((dia) => {
                  const placas = vehiculo.rotacion[dia] ?? [];
                  const esHoy = dia === ['domingo','lunes','martes','miercoles','jueves','viernes','sabado'][hoy.getDay()];
                  return (
                    <tr class:list={[
                      'border-t border-gray-100 dark:border-gray-800',
                      esHoy ? 'bg-yellow-50 dark:bg-yellow-950/20 font-semibold' : '',
                    ]}>
                      <td class="py-3 px-4">
                        {DIAS_LEGIBLES[dia]}
                        {esHoy && <span class="ml-2 text-xs text-yellow-600 dark:text-yellow-400">(hoy)</span>}
                      </td>
                      <td class="py-3 px-4 font-mono text-lg tracking-wider">
                        {placas.join(' · ')}
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
          {resultado.criterioPlaca && (
            <p class="mt-2 text-xs text-gray-500 dark:text-gray-400">
              * Según {CRITERIO_LEGIBLE[resultado.criterioPlaca]} de la placa
            </p>
          )}
        </section>
      )}

      <!-- Rotación quincenal (taxis) -->
      {esVehiculoQuincenal && (
        <section class="mb-8">
          <h2 class="text-xl font-bold mb-3">Calendario de restricción por placa</h2>
          <p class="text-sm text-gray-500 dark:text-gray-400 mb-3">
            Cada dígito tiene fechas específicas de restricción durante el semestre.
          </p>
          <div class="overflow-x-auto rounded-lg border border-gray-200 dark:border-gray-700">
            <table class="w-full text-sm">
              <thead>
                <tr class="bg-gray-50 dark:bg-gray-800">
                  <th class="py-3 px-4 text-left font-semibold">Placa</th>
                  <th class="py-3 px-4 text-left font-semibold">Próximas fechas de restricción</th>
                </tr>
              </thead>
              <tbody>
                {Object.entries(vehiculo.fechas_restriccion)
                  .sort(([a], [b]) => Number(a) - Number(b))
                  .map(([digito, fechas]) => {
                    const hoyISO = formatearISO(hoy);
                    const futuras = fechas.filter((f: string) => f >= hoyISO).slice(0, 4);
                    const aplicaHoy = fechas.includes(hoyISO);
                    return (
                      <tr class:list={[
                        'border-t border-gray-100 dark:border-gray-800',
                        aplicaHoy ? 'bg-red-50 dark:bg-red-950/20' : '',
                      ]}>
                        <td class="py-3 px-4 font-mono text-lg font-bold">
                          {digito}
                          {aplicaHoy && <span class="ml-2 text-xs text-red-600 dark:text-red-400 font-normal">(hoy)</span>}
                        </td>
                        <td class="py-3 px-4 text-xs text-gray-600 dark:text-gray-400">
                          {futuras.length > 0 ? futuras.join(' · ') : 'Sin fechas próximas'}
                        </td>
                      </tr>
                    );
                  })}
              </tbody>
            </table>
          </div>
          {vehiculo.nota_especial && (
            <div class="mt-3 rounded-lg border border-yellow-300 bg-yellow-50 p-3 dark:bg-yellow-950/20 dark:border-yellow-700">
              <p class="text-sm text-gray-700 dark:text-gray-300">
                <span class="font-semibold">Nota:</span> {vehiculo.nota_especial}
              </p>
            </div>
          )}
          {vehiculo.fechas_pendientes_confirmar && vehiculo.fechas_pendientes_confirmar.length > 0 && (
            <div class="mt-2 rounded-lg border border-orange-200 bg-orange-50 p-3 dark:bg-orange-950/20 dark:border-orange-700">
              <p class="text-xs font-semibold text-orange-700 dark:text-orange-300 mb-1">Pendiente de confirmar:</p>
              <ul class="text-xs text-gray-600 dark:text-gray-400 space-y-0.5">
                {vehiculo.fechas_pendientes_confirmar.map((nota: string) => (
                  <li>• {nota}</li>
                ))}
              </ul>
            </div>
          )}
        </section>
      )}
    </>
  )}

  <!-- Placeholder (ciudades sin datos) -->
  {esVehiculoPlaceholder && 'restricciones' in vehiculo && (
    <section class="mb-8">
      <h2 class="text-xl font-bold mb-3">Restricciones por día</h2>
      <div class="overflow-x-auto rounded-lg border border-gray-200 dark:border-gray-700">
        <table class="w-full text-sm">
          <thead>
            <tr class="bg-gray-50 dark:bg-gray-800">
              <th class="py-3 px-4 text-left font-semibold">Día</th>
              <th class="py-3 px-4 text-left font-semibold">Placas restringidas</th>
            </tr>
          </thead>
          <tbody>
            {diasSemana.map((dia) => {
              const placas = vehiculo.restricciones[dia] ?? [];
              const esPendiente = placas.some((p: string) => p === 'pendiente_verificar');
              return (
                <tr class="border-t border-gray-100 dark:border-gray-800">
                  <td class="py-3 px-4 font-medium">{DIAS_LEGIBLES[dia]}</td>
                  <td class="py-3 px-4 font-mono">
                    {esPendiente ? <span class="text-gray-400">Pendiente de verificar</span> : placas.join(', ')}
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </section>
  )}

  <!-- Callout Pico y Placa Solidario (si existe en esta ciudad) -->
  {ciudad.pico_y_placa_solidario && ciudad.pico_y_placa_solidario.existe === true && (
    <section class="mb-6 rounded-lg border-2 border-yellow-400 bg-yellow-50 dark:bg-yellow-950/20 p-4 flex flex-col sm:flex-row items-start sm:items-center gap-3">
      <span class="text-2xl shrink-0">🎟️</span>
      <div class="flex-1">
        <p class="text-sm font-semibold text-gray-800 dark:text-gray-200">
          ¿No puedes esperar a que cambie tu placa?
        </p>
        <p class="text-sm text-gray-600 dark:text-gray-400">
          {ciudad.nombre} ofrece el <strong>{ciudad.pico_y_placa_solidario.nombre_oficial}</strong> por
          <span class="font-mono font-bold">${ciudad.pico_y_placa_solidario.tarifas_base.diario.toLocaleString('es-CO')}</span>/día.
        </p>
      </div>
      <a
        href={ciudad.pico_y_placa_solidario.sitio_oficial}
        target="_blank"
        rel="noopener noreferrer"
        class="shrink-0 rounded-lg bg-yellow-400 hover:bg-yellow-500 text-black font-bold text-sm px-4 py-2 transition-colors"
      >
        Tramitar →
      </a>
    </section>
  )}

  </>)}

  <!-- Sanciones con enlace a Ley 769 -->
  <section class="mb-6 rounded-lg border border-red-200 bg-red-50 p-4 dark:bg-red-950/20 dark:border-red-800">
    <h2 class="text-lg font-bold mb-2 flex items-center gap-2">
      <svg class="w-5 h-5 text-red-600 dark:text-red-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.082 16.5c-.77.833.192 2.5 1.732 2.5z" />
      </svg>
      <span>Sanciones</span>
    </h2>
    <p class="text-sm text-gray-700 dark:text-gray-300">{ciudad.sanciones.descripcion}</p>
    {tieneSancionesDetalladas && (
      <div class="mt-3 grid grid-cols-2 sm:grid-cols-3 gap-2 text-center">
        {ciudad.sanciones.tipo_multa && (
          <div class="rounded bg-red-100 dark:bg-red-900/40 p-2">
            <p class="text-xs text-gray-500 dark:text-gray-400">Tipo</p>
            <p class="font-bold text-red-700 dark:text-red-300">{ciudad.sanciones.tipo_multa}</p>
          </div>
        )}
        {ciudad.sanciones.valor_smldv && (
          <div class="rounded bg-red-100 dark:bg-red-900/40 p-2">
            <p class="text-xs text-gray-500 dark:text-gray-400">Multa</p>
            <p class="font-bold text-red-700 dark:text-red-300">{ciudad.sanciones.valor_smldv}</p>
          </div>
        )}
        {ciudad.sanciones.valor_aproximado_pesos && (
          <div class="rounded bg-red-100 dark:bg-red-900/40 p-2">
            <p class="text-xs text-gray-500 dark:text-gray-400">Aprox.</p>
            <p class="font-bold text-red-700 dark:text-red-300">
              ${ciudad.sanciones.valor_aproximado_pesos.toLocaleString('es-CO')}
            </p>
          </div>
        )}
      </div>
    )}
    <p class="mt-2 text-xs text-gray-500 dark:text-gray-400">
      <a href={URL_LEY_769} target="_blank" rel="noopener noreferrer" class="text-red-600 dark:text-red-400 hover:underline">
        {ciudad.sanciones.base_legal}
      </a>
    </p>
    {ciudad.sanciones.incluye_inmovilizacion && (
      <p class="mt-1 text-xs font-semibold text-red-600 dark:text-red-400">
        + Inmovilización del vehículo
      </p>
    )}
  </section>

  <!-- Exenciones -->
  {tieneExenciones && (
    <section class="mb-6 rounded-lg border border-green-200 bg-green-50 p-4 dark:bg-green-950/20 dark:border-green-800">
      <h2 class="text-lg font-bold mb-2">Vehículos exentos</h2>
      <ul class="space-y-1.5">
        {ciudad.exenciones_generales!.map((exencion) => (
          <li class="text-sm text-gray-700 dark:text-gray-300 flex items-start gap-2">
            <span class="text-green-500 mt-0.5 shrink-0">✓</span>
            <span>{exencion}</span>
          </li>
        ))}
      </ul>
    </section>
  )}

  <!-- Mapa de vías exentas -->
  {mapaEnDetalle && mapaConfig && (
    <MapaViasExentas
      nombreCiudad={ciudad.nombre}
      centro={mapaConfig.centro}
      zoom={mapaConfig.zoom}
      geojson={mapaGeojson}
    />
  )}

  <!-- Lista textual de vías exentas -->
  {tieneViasExentas && (
    <section class="mb-6">
      <details class="rounded-lg border border-gray-200 dark:border-gray-700 overflow-hidden">
        <summary class="cursor-pointer bg-gray-50 dark:bg-gray-800 px-4 py-3 font-semibold text-sm hover:bg-gray-100 dark:hover:bg-gray-750">
          Lista completa de vías exentas ({ciudad.vias_exentas!.length})
        </summary>
        <div class="px-4 py-3 bg-white dark:bg-gray-900">
          <ul class="space-y-1.5">
            {ciudad.vias_exentas!.map((via) => (
              <li class="text-sm text-gray-700 dark:text-gray-300 flex items-start gap-2">
                <span class="text-green-500 mt-0.5 shrink-0">→</span>
                <span>{via}</span>
              </li>
            ))}
          </ul>
        </div>
      </details>
    </section>
  )}

  <!-- Canales oficiales -->
  {tieneContacto && (
    <section class="mb-6">
      <h2 class="text-lg font-bold mb-3">Canales oficiales</h2>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
        {tieneWeb && (
        <a href={contacto!.secretaria_movilidad} target="_blank" rel="noopener noreferrer"
          class="flex flex-col items-center gap-1.5 rounded-lg border border-gray-200 dark:border-gray-700 p-3 text-center hover:border-yellow-400 hover:bg-yellow-50 dark:hover:bg-yellow-950/20 transition-colors">
          <svg class="w-6 h-6 text-yellow-600 dark:text-yellow-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
          </svg>
          <span class="text-xs font-medium">Web oficial</span>
        </a>
        )}
        {tieneTwitter && (
        <a href={contacto!.twitter} target="_blank" rel="noopener noreferrer"
          class="flex flex-col items-center gap-1.5 rounded-lg border border-gray-200 dark:border-gray-700 p-3 text-center hover:border-yellow-400 hover:bg-yellow-50 dark:hover:bg-yellow-950/20 transition-colors">
          <svg class="w-6 h-6 text-yellow-600 dark:text-yellow-400" fill="currentColor" viewBox="0 0 24 24">
            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
          </svg>
          <span class="text-xs font-medium">X / Twitter</span>
        </a>
        )}
        {tieneFacebook && (
        <a href={contacto!.facebook} target="_blank" rel="noopener noreferrer"
          class="flex flex-col items-center gap-1.5 rounded-lg border border-gray-200 dark:border-gray-700 p-3 text-center hover:border-yellow-400 hover:bg-yellow-50 dark:hover:bg-yellow-950/20 transition-colors">
          <svg class="w-6 h-6 text-yellow-600 dark:text-yellow-400" fill="currentColor" viewBox="0 0 24 24">
            <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z" />
          </svg>
          <span class="text-xs font-medium">Facebook</span>
        </a>
        )}
        {tieneTelefono && (
        <a href={`tel:${contacto!.linea_atencion.replace(/\s|-/g, '')}`}
          class="flex flex-col items-center gap-1.5 rounded-lg border border-gray-200 dark:border-gray-700 p-3 text-center hover:border-yellow-400 hover:bg-yellow-50 dark:hover:bg-yellow-950/20 transition-colors">
          <svg class="w-6 h-6 text-yellow-600 dark:text-yellow-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          <span class="text-xs font-medium">{contacto!.linea_atencion}</span>
        </a>
        )}
      </div>
    </section>
  )}

  <!-- Otros tipos de vehículo en esta ciudad -->
  <section class="mb-6">
    <h2 class="text-lg font-bold mb-3">Otros tipos de vehículo en {ciudad.nombre}</h2>
    <div class="grid grid-cols-2 sm:grid-cols-3 gap-2">
      {tiposVehiculo.map((t) => {
        const esActual = t === tipo;
        return (
          <a
            href={esActual ? undefined : `/${ciudad.slug}/${t}`}
            class:list={[
              'flex items-center gap-2 rounded-lg border p-3 text-sm font-medium transition-colors',
              esActual
                ? 'border-yellow-400 bg-yellow-50 dark:bg-yellow-950/20 text-yellow-700 dark:text-yellow-400 cursor-default'
                : 'border-gray-200 dark:border-gray-700 hover:border-yellow-400 hover:bg-yellow-50 dark:hover:bg-yellow-950/20',
            ]}
          >
            <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded bg-white dark:bg-gray-800 p-1">
              <img src={ICONOS_VEHICULO[t]} alt={ETIQUETAS_VEHICULO[t]} class="h-full w-full object-contain" />
            </div>
            <span>{ETIQUETAS_VEHICULO[t]}</span>
            {esActual && <span class="ml-auto text-xs text-yellow-500">(actual)</span>}
          </a>
        );
      })}
    </div>
  </section>

  <!-- Consulta en otras ciudades -->
  <section class="mb-6">
    <h2 class="text-lg font-bold mb-3">Consulta Pico y Placa en otras ciudades</h2>
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-2">
      {otrasCiudades.map((c) => (
        <a
          href={`/${c.slug}`}
          class="rounded-lg border border-gray-200 dark:border-gray-700 px-3 py-2.5 text-sm font-medium text-center hover:border-yellow-400 hover:bg-yellow-50 dark:hover:bg-yellow-950/20 transition-colors"
        >
          {c.nombre}
        </a>
      ))}
    </div>
  </section>

  <!-- Pie -->
  <footer class="pt-4 border-t border-gray-200 dark:border-gray-800 text-sm text-gray-500 dark:text-gray-400">
    <p>
      {ciudad.decreto_actual !== 'pendiente_verificar' && <span>{ciudad.decreto_actual} · </span>}
      Última actualización: {ciudad.fecha_ultima_actualizacion}
    </p>
    <p class="mt-1">
      <a href={ciudad.autoridad_web} target="_blank" rel="noopener noreferrer" class="text-yellow-600 hover:underline">
        Verificar en fuente oficial →
      </a>
    </p>
  </footer>

</Principal>
