---
/**
 * Mapa interactivo de vías exentas usando Leaflet + OpenStreetMap.
 * Recibe GeoJSON con geometrías reales de OSM.
 * Se renderiza solo en el cliente (Leaflet no funciona en SSR).
 */

interface Props {
  nombreCiudad: string;
  centro: [number, number];
  zoom: number;
  geojson: unknown;
}

const { nombreCiudad, centro, zoom, geojson } = Astro.props;

const tieneGeojson = geojson && typeof geojson === 'object' && 'features' in (geojson as Record<string, unknown>);
const datosCliente = JSON.stringify({ centro, zoom, geojson: tieneGeojson ? geojson : null });
---

<!-- Leaflet CSS -->
<link
  rel="stylesheet"
  href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
  integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
  crossorigin=""
/>

<section class="mb-6">
  <h2 class="text-lg font-bold mb-3 flex items-center gap-2">
    <svg class="w-5 h-5 text-green-600 dark:text-green-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" />
    </svg>
    <span>Zonas sin restricción en {nombreCiudad}</span>
  </h2>

  {tieneGeojson ? (
    <div
      id="mapa-vias-exentas"
      class="h-[300px] sm:h-[400px] w-full rounded-lg border border-gray-200 dark:border-gray-700 z-0"
      data-mapa={datosCliente}
    ></div>
  ) : (
    <div class="h-[200px] w-full rounded-lg border border-gray-200 dark:border-gray-700 flex items-center justify-center bg-gray-50 dark:bg-gray-800">
      <p class="text-sm text-gray-500 dark:text-gray-400">
        Mapa no disponible. Ejecuta <code class="bg-gray-200 dark:bg-gray-700 px-1 rounded">npm run fetch-vias</code> para generar las geometrías.
      </p>
    </div>
  )}

  <!-- Leyenda -->
  <p class="mt-2 text-sm text-gray-500 dark:text-gray-400 flex items-center gap-2">
    <span class="inline-block w-8 h-1 rounded bg-green-600"></span>
    Vías exentas (puedes circular con pico y placa)
  </p>
</section>

<script>
  async function inicializarMapa() {
    const contenedor = document.getElementById('mapa-vias-exentas');
    if (!contenedor) return;

    const datos = JSON.parse(contenedor.dataset.mapa || '{}');
    if (!datos.centro || !datos.geojson) return;

    const L = await import('leaflet');

    const mapa = L.map('mapa-vias-exentas', {
      scrollWheelZoom: false,
    }).setView(datos.centro, 13);

    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
      maxZoom: 18,
    }).addTo(mapa);

    // Dibujar GeoJSON con estilo verde y ajustar zoom a los bounds
    const capaVias = L.geoJSON(datos.geojson, {
      style: {
        color: '#16A34A',
        weight: 5,
        opacity: 0.8,
      },
      onEachFeature: (feature: { properties?: { name?: string } }, layer: L.Layer) => {
        const nombre = feature.properties?.name ?? 'Vía exenta';
        (layer as L.Path).bindPopup(
          `<strong>${nombre}</strong><br><span style="color:#16A34A">Vía exenta de pico y placa</span>`
        );
      },
    }).addTo(mapa);

    // Ajustar el mapa para mostrar todas las vías con padding
    const bounds = capaVias.getBounds();
    if (bounds.isValid()) {
      mapa.fitBounds(bounds, { padding: [40, 40] });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', inicializarMapa);
  } else {
    inicializarMapa();
  }
</script>
