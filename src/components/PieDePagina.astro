---
import MapaColombia from './MapaColombia.astro';
import { ciudades } from '../lib/ciudades';

const anio = new Date().getFullYear();

const ciudadesMarkers = ciudades
  .filter((c) => c.coordenadas)
  .map((c) => ({
    slug: c.slug,
    nombre: c.nombre,
    coordenadas: c.coordenadas!,
    tieneData: c.decreto_actual !== 'pendiente_verificar' && c.decreto_actual !== 'No aplica',
  }));
---

<!-- Sección de ciudades antes del footer -->
<section class="border-t border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-900 py-8">
  <div class="mx-auto max-w-5xl px-4">
    <h3 class="text-lg font-bold mb-3 text-center">Pico y Placa en otras ciudades de Colombia</h3>
    <MapaColombia
      ciudades={ciudadesMarkers}
      altura="h-[250px] sm:h-[300px]"
      id="mapa-colombia-footer"
    />
    <p class="mt-2 text-xs text-gray-400 text-center">
      Selecciona tu ciudad en el mapa o en la lista para consultar.
    </p>
    <div class="grid grid-cols-3 sm:grid-cols-4 lg:grid-cols-6 gap-1.5 mt-4">
      {ciudades.map((c) => (
        <a
          href={`/${c.slug}`}
          class="text-xs text-center text-gray-500 dark:text-gray-400 hover:text-yellow-600 dark:hover:text-yellow-400 hover:underline py-1"
        >
          {c.nombre}
        </a>
      ))}
    </div>
  </div>
</section>

<footer class="border-t border-gray-200 bg-white py-6 text-center text-sm text-gray-500 dark:border-gray-700 dark:bg-[#0A0A0A] dark:text-gray-400">
  <div class="mx-auto max-w-5xl px-4">
    <p>
      Los datos de Pico y Placa son informativos. Verifica siempre con la fuente oficial de tu ciudad.
    </p>
    <div class="mt-3 flex flex-wrap items-center justify-center gap-x-4 gap-y-2">
      <a href="/pico-y-placa-manana" class="hover:underline">Pico y Placa mañana</a>
      <a href="/exenciones-pico-y-placa" class="hover:underline">Exenciones</a>
      <a href="/multas-pico-y-placa" class="hover:underline">Multas</a>
      <a href="/preguntas-frecuentes" class="hover:underline">Preguntas frecuentes</a>
      <a href="/politica-de-privacidad" class="hover:underline">Política de privacidad</a>
    </div>
    <p class="mt-3">&copy; {anio} picoyplacahoy.co</p>
  </div>
</footer>
