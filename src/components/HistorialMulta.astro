---
/**
 * Cómo ha cambiado la multa del Pico y Placa año por año, con la flecha de
 * variación calculada de los datos (sube o baja sola, según lo cargado en
 * src/data/multas.json). No muestra años posteriores al vigente, por si se
 * carga el del año siguiente antes del 1 de enero.
 */
import type { MultaVigente } from '../lib/multas';
import { historialMulta, formatearPesos, formatearUnidades, describirVariacion } from '../lib/multas';

interface Props {
  multa: MultaVigente;
}

const { multa } = Astro.props;
const filas = historialMulta.filter((m) => m.anio <= multa.anio);

const COLOR_VARIACION: Record<'sube' | 'baja' | 'igual', string> = {
  sube: 'text-red-600 dark:text-red-400',
  baja: 'text-green-600 dark:text-green-400',
  igual: 'text-gray-500 dark:text-gray-400',
};
const TEXTO_SENTIDO: Record<'sube' | 'baja' | 'igual', string> = {
  sube: 'Subió',
  baja: 'Bajó',
  igual: 'Sin cambio',
};

// Fuentes: una tabla oficial por año en UVB (la de 2024 trae también el valor de 2023)
const tablas = filas.filter((m) => m.unidad === 'UVB');
const primerAnioUvt = filas.find((m) => m.unidad === 'UVT');
const enlace = 'underline hover:text-gray-700 dark:hover:text-gray-200';
---

<section class="rounded-lg border border-gray-200 p-4 dark:border-gray-700" aria-labelledby="historial-multa">
  <h2 id="historial-multa" class="text-lg font-semibold">¿Cuánto ha subido la multa?</h2>
  <p class="mt-1 text-gray-600 dark:text-gray-400">
    Desde 2024 la multa se calcula en UVB (Unidad de Valor Básico), que el
    Gobierno ajusta cada enero con la inflación sin alimentos ni regulados. Ya
    no sube con el salario mínimo. Así ha cambiado:
  </p>

  <div class="mt-3 overflow-x-auto">
    <table class="w-full text-left text-xs sm:text-sm">
      <thead>
        <tr class="border-b border-gray-200 text-gray-500 dark:border-gray-700 dark:text-gray-400">
          <th class="py-2 pr-3 font-medium">Año</th>
          <th class="py-2 pr-3 font-medium">Cálculo</th>
          <th class="py-2 pr-3 text-right font-medium">Multa</th>
          <th class="py-2 text-right font-medium">Cambio</th>
        </tr>
      </thead>
      <tbody>
        {filas.map((m) => {
          const v = m.variacion !== null ? describirVariacion(m.variacion) : null;
          return (
            <tr class={`border-b border-gray-100 dark:border-gray-800 ${m.anio === multa.anio ? 'bg-yellow-50 font-semibold dark:bg-yellow-950/20' : ''}`}>
              <td class="py-2 pr-3 font-mono">{m.anio}</td>
              <td class="py-2 pr-3 whitespace-nowrap text-gray-600 dark:text-gray-400">
                {formatearUnidades(m.cantidad_unidades)} {m.unidad} × {formatearPesos(m.valor_unidad)}
              </td>
              <td class="py-2 pr-3 text-right font-mono whitespace-nowrap">{formatearPesos(m.multa)}</td>
              <td class="py-2 text-right whitespace-nowrap">
                {v ? (
                  <span class={`font-semibold ${COLOR_VARIACION[v.sentido]}`}>
                    <span aria-hidden="true">{v.flecha}</span>
                    <span class="sr-only">{TEXTO_SENTIDO[v.sentido]}</span> {v.porcentaje}
                  </span>
                ) : (
                  <span class="text-gray-400">—</span>
                )}
              </td>
            </tr>
          );
        })}
      </tbody>
    </table>
  </div>

  <p class="mt-2 text-xs text-gray-500 dark:text-gray-400">
    Fuentes: tablas oficiales de autoliquidación de la Secretaría Distrital de
    Movilidad de Bogotá de{' '}
    {tablas.map((m, i) => (
      <>
        <a href={m.url_fuente} target="_blank" rel="noopener" class={enlace}>{m.anio}</a>{i < tablas.length - 2 ? ', ' : i === tablas.length - 2 ? ' y ' : ''}
      </>
    ))}
    {primerAnioUvt && <> (la de {primerAnioUvt.anio + 1} trae también el valor de {primerAnioUvt.anio}, que se calculaba en UVT)</>}.
    Valor de la UVB: {tablas.map((m) => m.norma_valor_unidad).join('; ')}.
  </p>
</section>
